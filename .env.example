# Reference only. ./tari init generates private .local/runtime.env.
# Edit that generated file; never put actual secrets in this template.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TARI_NAME=Tari
TARI_MODEL=openai/gpt-6.1-sol
TARI_TIMEZONE=UTC
TARI_PORT=18899
TARI_GOOGLE_ACCOUNT=
# Calendar mutations need a separate OAuth client profile AND this opt-in.
TARI_CALENDAR_WRITES=0
