# Allow only reviewed source roots. Local credentials and runtime state stay private.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/LICENSE
!/README.md
!/SECURITY.md
!/compose.yaml
!/tari
!/config/
!/docker/
!/docs/
!/examples/
!/scripts/
!/tests/
!/workspace/
!/plugins/
**/__pycache__/
**/*.pyc
**/.DS_Store
**/.env
**/*.sqlite*
**/*.db
**/*.log
**/node_modules/
workspace/planner/
workspace/memory/
workspace/documents/
workspace/state/
workspace/inbox/
**/*credentials*.json
**/*token*.json
