#!/usr/bin/env python3
"""Read-only, bounded source collection for a requested brief; no scheduling or writes."""
import argparse
from datetime import date, datetime, time, timedelta, timezone
import json
import os
from pathlib import Path
import subprocess
import sys
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

MAX_OUTPUT = 256 * 1024
MAX_NOTES = 12
WARNING_MESSAGES = {
    "PLANNER_SCHEDULE_MALFORMED": "Some local planner schedule entries could not be parsed.",
    "PLANNER_CHECKLIST_MALFORMED": "Some local planner checklist entries could not be parsed.",
    "CALENDAR_NOT_CHECKED": "Calendar is outside this local planner source's scope.",
    "CALENDAR_UNAVAILABLE": "Calendar could not be read; schedule coverage is incomplete.",
    "SOURCE_WARNING": "The source reported a warning; its coverage may be incomplete.",
    "SOURCE_DIAGNOSTIC_PRESENT": "The source reported a diagnostic; its coverage may be incomplete.",
    "SOURCE_MALFORMED": "The source returned malformed or unexpected data.",
    "SOURCE_UNAVAILABLE": "Source retrieval failed; do not infer it is empty.",
    "SOURCE_OUTPUT_LIMIT": "Source output exceeded the collection limit.",
}


def window(day, zone, now):
    local = now.astimezone(zone).date()
    chosen = local if day == "today" else local + timedelta(days=1) if day == "tomorrow" else date.fromisoformat(day)
    start = datetime.combine(chosen, time.min, zone)
    end = datetime.combine(chosen + timedelta(days=1), time.min, zone)
    return chosen, start, end


def safe(path, root):
    if not path.is_relative_to(root) or ".." in path.relative_to(root).parts:
        raise ValueError("Source path outside workspace")
    for part in [root, *path.parents, path]:
        if part.is_symlink():
            raise ValueError("Source paths must not use symlinks")
    return path


def note(path, root, limit):
    try:
        safe(path, root)
        if not path.exists():
            return {"status": "absent", "source": str(path.relative_to(root))}
        with path.open(encoding="utf-8") as handle:
            text = handle.read(limit + 1)
        return {"status": "available", "source": str(path.relative_to(root)),
                "text": text[:limit], "truncated": len(text) > limit, "untrusted_content": True}
    except (OSError, ValueError):
        return {"status": "unavailable", "source": str(path.relative_to(root)), "reason": "Source could not be read safely"}


def helper(root, name, args):
    def unavailable(code, quality="unavailable"):
        return {"status": "unavailable", "quality": quality, "reason": WARNING_MESSAGES[code],
                "warnings": [{"code": code, "message": WARNING_MESSAGES[code]}]}
    try:
        tool = safe(root / "bin" / name, root)
        result = subprocess.run([sys.executable, str(tool), *args], cwd=root, capture_output=True,
                                text=True, timeout=65, check=False)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return unavailable("SOURCE_UNAVAILABLE")
    if result.returncode:
        return unavailable("SOURCE_UNAVAILABLE")
    if len(result.stdout.encode()) > MAX_OUTPUT:
        return unavailable("SOURCE_OUTPUT_LIMIT", "incomplete")
    try:
        data = json.loads(result.stdout)
    except (ValueError, TypeError):
        return unavailable("SOURCE_MALFORMED", "malformed")
    if not isinstance(data, dict):
        return unavailable("SOURCE_MALFORMED", "malformed")
    if name == "day-planner" and (not isinstance(data.get("schedule"), list)
                                  or not isinstance(data.get("checklist"), list)):
        return unavailable("SOURCE_MALFORMED", "malformed")
    if name == "day-planner" and any(not isinstance(row, dict) for key in ("schedule", "checklist") for row in data[key]):
        return unavailable("SOURCE_MALFORMED", "malformed")
    declared = data.get("data_status")
    if ("data_status" in data and (not isinstance(declared, str) or declared not in {"complete", "incomplete", "malformed"})) \
            or ("complete" in data and type(data["complete"]) is not bool):
        return unavailable("SOURCE_MALFORMED", "malformed")
    details = []
    raw_details = data.get("warning_details", [])
    if not isinstance(raw_details, list):
        return unavailable("SOURCE_MALFORMED", "malformed")
    for entry in raw_details[:32]:
        code = entry.get("code") if isinstance(entry, dict) else None
        code = code if isinstance(code, str) and code in WARNING_MESSAGES else "SOURCE_WARNING"
        detail = {"code": code, "message": WARNING_MESSAGES[code]}
        if isinstance(entry, dict) and type(entry.get("count")) is int and 0 <= entry["count"] <= 100000:
            detail["count"] = entry["count"]
        details.append(detail)
    if data.get("warnings") and not details:
        details.append({"code": "SOURCE_WARNING", "message": WARNING_MESSAGES["SOURCE_WARNING"]})
    if result.stderr.strip():
        details.append({"code": "SOURCE_DIAGNOSTIC_PRESENT", "message": WARNING_MESSAGES["SOURCE_DIAGNOSTIC_PRESENT"]})
    quality = declared if isinstance(declared, str) and declared in {"complete", "incomplete", "malformed"} else "complete"
    meaningful = [entry for entry in details if entry["code"] != "CALENDAR_NOT_CHECKED"]
    if any(entry["code"] in {"PLANNER_SCHEDULE_MALFORMED", "PLANNER_CHECKLIST_MALFORMED"} for entry in details):
        quality = "malformed"
    elif meaningful or data.get("complete") is False:
        quality = "incomplete" if quality == "complete" else quality
    if quality != "complete" and not meaningful:
        details.append({"code": "SOURCE_WARNING", "message": WARNING_MESSAGES["SOURCE_WARNING"]})
    if name == "day-planner":
        data = {key: data[key] for key in ("date", "schedule", "checklist") if key in data}
    else:
        data = dict(data)
        data.pop("warning_details", None)
    if details:
        data["warnings"] = [entry["message"] for entry in details]
    return {"status": "available" if quality == "complete" else "partial", "quality": quality,
            "warnings": details, "data": data, "untrusted_content": True}


def collect(day="today", local_only=False, now=None, private_memory=False):
    root = Path(os.environ.get("TARI_WORKSPACE", Path(__file__).absolute().parent.parent)).absolute()
    zone_name = os.environ.get("TARI_TIMEZONE") or "UTC"
    try:
        zone = ZoneInfo(zone_name)
    except (ZoneInfoNotFoundError, ValueError):
        raise ValueError("Invalid TARI_TIMEZONE; set a valid IANA timezone with ./tari timezone ZONE") from None
    now = now or datetime.now(timezone.utc)
    chosen, start, end = window(day, zone, now)
    notes = []
    try:
        directory = safe(root / "domains", root)
        paths = sorted(directory.glob("*.md")) if directory.is_dir() else []
        notes = [note(path, root, 3000) for path in paths[:MAX_NOTES]]
        domains = {"status": "available", "files": notes, "truncated": len(paths) > MAX_NOTES}
    except (OSError, ValueError):
        domains = {"status": "unavailable", "reason": "Domain directory unavailable"}
    result = {"date": chosen.isoformat(), "time_zone": zone_name, "as_of": now.astimezone(zone).isoformat(),
              "calendar_window": {"start": start.isoformat(), "end": end.isoformat()},
              "sources": {"domains": domains,
                  "preferences": note(root / "USER.md", root, 3000),
                  "memory": note(root / "MEMORY.md", root, 4000) if private_memory else {"status": "not_requested"},
                  "planner": helper(root, "day-planner", ["show", chosen.isoformat(), "--json", "--no-calendar"])},
              "read_only": True, "untrusted_content": True,
              "instruction": "Synthesize an adaptive brief using available sources and source precedence. No writes or inferred commitments. Disclose unavailable and bounded sources."}
    sources = result["sources"]
    sources["planner"]["scope"] = "Local blocks/checklist only; Calendar is collected separately"
    configured = bool(os.environ.get("TARI_GOOGLE_ACCOUNT") or os.environ.get("GOG_ACCOUNT"))
    if local_only or not configured:
        status = "not_requested" if local_only else "not_configured"
        sources["calendar"] = {"status": status}
        sources["gmail"] = {"status": status}
    else:
        sources["calendar"] = helper(root, "tari-google", ["calendar", "list", "--start", start.isoformat(), "--end", end.isoformat(), "--json"])
        # Epoch bounds avoid Gmail's timezone-dependent date-only query semantics.
        lower, upper = int((now - timedelta(days=2)).timestamp()), int(now.timestamp()) + 1
        query = f"after:{lower} before:{upper}"
        sources["gmail"] = helper(root, "tari-google", ["gmail", "search", query, "--max", "20"])
        sources["gmail"]["scope"] = {"query": query, "max_messages": 20, "complete_inbox_recap": False,
                                      "description": "Recent 48 hours, first bounded page, read and unread"}
        envelope = sources["gmail"].get("data", {}).get("data", {})
        if isinstance(envelope, dict) and envelope.get("nextPageToken"):
            sources["gmail"]["pagination_remaining"] = True
    # DailyGrad is deliberately selective and never generated by a briefing read.
    sources["dailygrad"] = {"status": "not_requested", "guidance": "If DailyGrad is relevant and configured, use dailygrad_digest only; do not run or repair it"}
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("day", nargs="?", default="today")
    parser.add_argument("--local-only", action="store_true")
    parser.add_argument("--private-memory", action="store_true",
                        help="Include curated memory only for an authorized private owner conversation")
    args = parser.parse_args()
    try:
        print(json.dumps(collect(args.day, args.local_only, private_memory=args.private_memory), ensure_ascii=False))
        return 0
    except (OSError, ValueError) as error:
        print(json.dumps({"error": str(error), "read_only": True}), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
